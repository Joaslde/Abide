{
  "appId": "com.toabide.app",
  "appName": "Abide",
  "webDir": "dist",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0B1624",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "CapacitorSQLite": {
      "iosDatabaseLocation": "Library/CapacitorDatabase",
      "iosIsEncryption": false,
      "androidIsEncryption": false
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "34894391883-sn5akdqig9b66jun8t3bgb0h36hdlpmq.apps.googleusercontent.com",
      "androidClientId": "34894391883-bemreedn3dq8htpuuv7viqeqp4o2d0v2.apps.googleusercontent.com"
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "automatic"
  }
}
