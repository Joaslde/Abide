# ============================================================
# ABIDE — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# JAMAIS committer .env.local
# ============================================================

# --- Supabase (public, préfixe VITE_ OK) ---
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# --- BibleBrain / FCBH (public, utilisé dans biblebrain.js) ---
VITE_BIBLEBRAIN_KEY=

# --- Paiements (public keys uniquement — jamais les secrets) ---
VITE_KKIAPAY_PUBLIC_KEY=
VITE_FEDAPAY_PUBLIC_KEY=

# --- AdMob (IDs publics — modèle interstitiel, cf. CLAUDE.md §AdMob) ---
# App ID : aussi requis en STATIQUE dans AndroidManifest.xml (meta-data) / Info.plist iOS.
VITE_ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxx~xxxxx
VITE_ADMOB_APP_ID_IOS=ca-app-pub-xxxxx~xxxxx
# Ad Unit interstitiel. Laisser VIDE en dev → le code bascule sur l'ID de TEST Google
# (isTesting=true). Renseigner UNIQUEMENT au lancement (compte AdMob validé).
VITE_ADMOB_INTERSTITIAL_ID=

# --- AppsFlyer (Dev Key publique — programme de parrainage, attribution d'installs) ---
VITE_APPSFLYER_DEV_KEY=
# OneLink créé dans le dashboard AppsFlyer (Engagement & Deep Linking → OneLink).
VITE_APPSFLYER_ONELINK_URL=https://xxxxx.onelink.me/xxxx/xxxxxxxx

# --- Cloudflare R2 (SECRETS — scripts d'upload LOCAUX uniquement, jamais dans l'app) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=abide
# URL PUBLIQUE du bucket R2 (accès public activé) — utilisée par scripts/upload-version.js
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# --- Manifeste des versions Bible téléchargeables (URL PUBLIQUE, lue par l'app) ---
# = R2_PUBLIC_BASE_URL + /bibles/manifest.json
VITE_BIBLE_MANIFEST_URL=https://pub-xxxxx.r2.dev/bibles/manifest.json

# ============================================================
# SECRETS — NE JAMAIS mettre en VITE_ — uniquement Edge Functions Supabase
# ============================================================
# OPENROUTER_KEY=sk-or-v1-...   -> Supabase Edge Function secret
# OPENAI_KEY=sk-...             -> Supabase Edge Function secret
# KKIAPAY_SECRET_KEY=           -> Supabase Edge Function secret
# FEDAPAY_SECRET_KEY=           -> Supabase Edge Function secret
# PAYMENT_WEBHOOK_SECRET=       -> Supabase Edge Function secret
